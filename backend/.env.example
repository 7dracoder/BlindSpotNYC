MONGODB_URI=
MONGODB_DB=blindspot
# Tiger Cloud service connection string (postgres://...?sslmode=require)
TIGER_DATABASE_URL=
# Briefing: Gemini is used when set, otherwise Grok
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
XAI_API_KEY=
XAI_MODEL=grok-4.7
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# From: uv run python scripts/create_voice_agent.py
ELEVENLABS_AGENT_ID=
TAVILY_API_KEY=
# Optional Follow the Money sandbox integration; never a VITE_ variable.
NESSIE_API_KEY=
NESSIE_API_URL=https://prod-api.nessieisreal.com
PUBLIC_APP_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: serve a built frontend from the API (Docker sets this automatically).
FRONTEND_DIST=
AUDIO_DIR=data/audio
# Vercel: true skips background layer warmup and stores briefing audio in Atlas.
SERVERLESS=false
